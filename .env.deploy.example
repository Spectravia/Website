# Copy to .env.deploy (git-ignored). Used by `npm run deploy:static`.
# Hostinger: hPanel → Files → FTP Accounts.
FTP_HOST=ftp.spectravia.net
FTP_PORT=21
FTP_USER=u123456789.spectravia
FTP_PASSWORD=change-me
# Explicit FTPS (recommended). Set to false only if the server rejects it.
FTP_SECURE=true
# Folder the domain serves. Hostinger FTP accounts are often already rooted at
# public_html: in that case use "/" instead.
FTP_REMOTE_DIR=/public_html
