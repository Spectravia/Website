# Copy to .env (local) or set these in the hosting control panel (production).
# Nuxt maps NUXT_* variables onto runtimeConfig automatically.

# --- Public ---
NUXT_PUBLIC_SITE_URL=https://spectravia.net

# --- SMTP (mailbox used to send contact-form notifications) ---
NUXT_MAIL_SMTP_HOST=smtp.example.com
# 465 = implicit TLS (secure=true) | 587 = STARTTLS (secure=false)
NUXT_MAIL_SMTP_PORT=465
NUXT_MAIL_SMTP_SECURE=true
NUXT_MAIL_SMTP_USER=hi@spectravia.net
NUXT_MAIL_SMTP_PASS=change-me

# Sender shown on notifications (defaults to SMTP user)
NUXT_MAIL_FROM="Spectravia Website <hi@spectravia.net>"
# Recipient(s) of contact-form submissions, comma-separated
NUXT_MAIL_TO=hi@spectravia.net
NUXT_MAIL_SUBJECT_PREFIX=[Spectravia website]

# --- Contact form abuse protection ---
NUXT_CONTACT_RATE_LIMIT_MAX=5
NUXT_CONTACT_RATE_LIMIT_WINDOW_MINUTES=15

# --- Server ---
# PORT=3000
# HOST=0.0.0.0
